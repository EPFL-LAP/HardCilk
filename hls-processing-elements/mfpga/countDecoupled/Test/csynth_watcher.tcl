# Generated by bombyx-cc — Vitis HLS synthesis script
# Application : memAccess
# Kernel      : watcher
# Part        : xcu55c-fsvh2892-2L-e
# Clock       : 300 MHz  (3.3333 ns)
#
# Run from the PE work directory:
#   mkdir -p vitis_hls_work/watcher
#   cd vitis_hls_work/watcher
#   vitis_hls -f ../../hls_tcl/watcher.tcl
# =============================================================================

set script_dir [file normalize [file dirname [info script]]]
set src_dir    [file normalize [file join $script_dir ".."]]

# ── Project setup ─────────────────────────────────────────────────────────────
open_project -reset watcher_proj
set_top watcher

# ── Source files ──────────────────────────────────────────────────────────────
add_files [file join $src_dir memAccess.cpp]
add_files [file join $src_dir memAccess_defs.h]

# ── Solution configuration ────────────────────────────────────────────────────
# Vivado IP flow (NOT -flow_target vitis): the watcher is an internal free-running
# block inside the HardCilk top, not a standalone Vitis kernel. The vitis flow
# forces every scalar through an s_axilite control block and ignores ap_ctrl_none/
# ap_none, which would hide the discrete per-PE status pins. The vivado flow honors
# the kernel's interface pragmas and emits ap_ctrl_none + discrete ap_none ports.
open_solution -reset "solution1" -flow_target vivado
set_part {xcu55c-fsvh2892-2L-e}
create_clock -period 3.3333 -name default

# ── AXI memory interface directives ──────────────────────────────────────────
config_interface -m_axi_addr64
config_interface -m_axi_num_read_outstanding 32
config_interface -m_axi_num_write_outstanding 32

# ── Synthesis ─────────────────────────────────────────────────────────────────
csynth_design

# ── Teardown ──────────────────────────────────────────────────────────────────
close_project
exit
